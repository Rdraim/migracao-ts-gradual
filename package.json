{
  "name": "migracao-ts-gradual",
  "version": "1.2.1",
  "description": "Playbook e ferramentas puras para migrar JavaScript para TypeScript aos poucos (allowJs, checkJs, renomear por módulo, zero big-bang). Mede progresso e conta usos de any. Zero dependências.",
  "type": "module",
  "main": "src/progresso.js",
  "exports": {
    ".": {
      "types": "./src/progresso.d.ts",
      "default": "./src/progresso.js"
    },
    "./git": {
      "types": "./tools/progresso-git.d.ts",
      "default": "./tools/progresso-git.mjs"
    }
  },
  "files": [
    "src",
    "*.md",
    "LICENSE",
    "assets/support",
    "examples",
    "test",
    "test-types",
    "tools"
  ],
  "scripts": {
    "test": "node --test",
    "example": "node examples/uso.mjs",
    "check:public": "node tools/check-public-content.mjs --history",
    "progress": "node tools/progresso-git.mjs",
    "check": "node --check src/progresso.js",
    "example:integration": "node examples/integracao.mjs",
    "check:package": "node tools/check-package.mjs"
  },
  "keywords": [
    "typescript",
    "javascript",
    "migracao",
    "allowjs",
    "checkjs",
    "tsconfig",
    "pt-br"
  ],
  "author": "Rodrigo Rodrigues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rdraim/migracao-ts-gradual.git"
  },
  "bugs": {
    "url": "https://github.com/Rdraim/migracao-ts-gradual/issues"
  },
  "homepage": "https://github.com/Rdraim/migracao-ts-gradual#readme",
  "engines": {
    "node": ">=22"
  },
  "types": "./src/progresso.d.ts"
}
